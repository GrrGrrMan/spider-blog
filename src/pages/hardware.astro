---
import MainLayout from '../layouts/MainLayout.astro';
import TechBadge from '../components/TechBadge.astro';
import { PRODUCT_LINKS } from '../data/links';
---

<MainLayout title="Hardware & 3D CAD">
  <section class="border-b border-zinc-800 pb-5 mb-6">
    <div class="font-mono text-xs text-sky-400 mb-1">// MECHANICAL_DESIGN</div>
    <h1 class="text-2xl sm:text-3xl font-bold text-zinc-100 mb-2">Hardware & 3D CAD Models</h1>
    <p class="text-xs sm:text-sm text-zinc-400">
      Click any CAD model below to open the interactive 3D assembly in Onshape.
    </p>
  </section>

  <!-- 3 Leg Joints with Overlay CAD Links -->
  <section class="mb-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-mono text-xs font-semibold text-zinc-400 uppercase tracking-wider">
        // 3-DOF Leg Anatomy (Hip, Thigh, Shin)
      </h2>
      <a href={PRODUCT_LINKS.cad.leg} target="_blank" class="font-mono text-xs text-sky-400 hover:underline">
        Open Full Leg CAD &rarr;
      </a>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <!-- Coxa (Hip) -->
      <div class="border border-zinc-800 bg-zinc-900/60 rounded-xl overflow-hidden flex flex-col">
        <div class="bg-zinc-900 px-3 py-2 border-b border-zinc-800 font-mono text-xs text-zinc-300 flex justify-between items-center">
          <span>01_COXA (HIP)</span>
          <span class="text-sky-400 text-[10px]">TURNS LEFT/RIGHT</span>
        </div>
        <div class="p-3 bg-zinc-950/80 flex flex-col items-center justify-center border-b border-zinc-800/80 h-44 relative group">
          <a href={PRODUCT_LINKS.cad.leg} target="_blank" class="text-[11px] font-mono text-sky-400 bg-zinc-900 border border-zinc-700 px-2.5 py-1 rounded hover:bg-sky-500/20 transition-colors">
            View in Onshape 3D
          </a>
        </div>
        <div class="p-3.5 text-xs text-zinc-300 leading-relaxed flex-grow font-sans">
          Rotates the entire leg horizontally (yaw). Controls steering and lets the spider spin in place.
        </div>
      </div>

      <!-- Femur (Thigh) -->
      <div class="border border-zinc-800 bg-zinc-900/60 rounded-xl overflow-hidden flex flex-col">
        <div class="bg-zinc-900 px-3 py-2 border-b border-zinc-800 font-mono text-xs text-zinc-300 flex justify-between items-center">
          <span>02_FEMUR (THIGH)</span>
          <span class="text-sky-400 text-[10px]">LIFTS UP/DOWN</span>
        </div>
        <div class="p-3 bg-zinc-950/80 flex flex-col items-center justify-center border-b border-zinc-800/80 h-44 relative group">
          <a href={PRODUCT_LINKS.cad.leg} target="_blank" class="text-[11px] font-mono text-sky-400 bg-zinc-900 border border-zinc-700 px-2.5 py-1 rounded hover:bg-sky-500/20 transition-colors">
            View in Onshape 3D
          </a>
        </div>
        <div class="p-3.5 text-xs text-zinc-300 leading-relaxed flex-grow font-sans">
          Lifts the foot off the ground during each step. Carries the main weight of the robot.
        </div>
      </div>

      <!-- Tibia (Shin/Foot) -->
      <div class="border border-zinc-800 bg-zinc-900/60 rounded-xl overflow-hidden flex flex-col">
        <div class="bg-zinc-900 px-3 py-2 border-b border-zinc-800 font-mono text-xs text-zinc-300 flex justify-between items-center">
          <span>03_TIBIA (SHIN)</span>
          <span class="text-sky-400 text-[10px]">REACHES FORWARD</span>
        </div>
        <div class="p-3 bg-zinc-950/80 flex flex-col items-center justify-center border-b border-zinc-800/80 h-44 relative group">
          <a href={PRODUCT_LINKS.cad.leg} target="_blank" class="text-[11px] font-mono text-sky-400 bg-zinc-900 border border-zinc-700 px-2.5 py-1 rounded hover:bg-sky-500/20 transition-colors">
            View in Onshape 3D
          </a>
        </div>
        <div class="p-3.5 text-xs text-zinc-300 leading-relaxed flex-grow font-sans">
          Extends the lower leg to touch the ground smoothly, adapting to bumps and obstacles.
        </div>
      </div>
    </div>
  </section>

  <!-- Prototype Evolution Cards -->
  <section class="space-y-4">
    <h2 class="font-mono text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">
      // Chassis Evolution (3 Iterations)
    </h2>

    <!-- Prototype 1 -->
    <div class="border border-zinc-800 bg-zinc-900/40 rounded-xl p-4">
      <div class="flex items-center justify-between mb-2">
        <h3 class="font-mono text-xs sm:text-sm font-semibold text-zinc-200">Prototype 1.0 &bull; Acrylic Sheets & Hot Glue</h3>
        <TechBadge text="Physical Test" />
      </div>
      <p class="text-xs text-zinc-400 leading-relaxed font-sans">
        Built a quick mockup out of acrylic sheets and hot glue. The joints snapped under motor force, proving we needed high-strength 3D printed parts.
      </p>
    </div>

    <!-- Prototype 2 -->
    <div class="border border-zinc-800 bg-zinc-900/40 rounded-xl p-4">
      <div class="flex items-center justify-between mb-2">
        <h3 class="font-mono text-xs sm:text-sm font-semibold text-zinc-200">Prototype 2.0 &bull; Flat 3D Plate Platform</h3>
        <a href={PRODUCT_LINKS.cad.body1} target="_blank" class="font-mono text-[11px] text-sky-400 hover:underline">
          View Body 1.0 CAD &rarr;
        </a>
      </div>
      <p class="text-xs text-zinc-400 leading-relaxed font-sans">
        3D printed PETG legs on a flat plate. Validated our Inverse Kinematics math, but the open design left wires unprotected and onboard batteries made it too heavy.
      </p>
    </div>

    <!-- Prototype 3 (Final Release) -->
    <div class="border border-zinc-800 bg-zinc-900/60 rounded-xl overflow-hidden">
      <div class="bg-zinc-900 px-4 py-2.5 border-b border-zinc-800 flex items-center justify-between">
        <h3 class="font-mono text-xs sm:text-sm font-semibold text-zinc-200">Prototype 3.0 &bull; Enclosed 3D Monocoque Chassis</h3>
        <span class="font-mono text-[10px] text-emerald-400 font-semibold bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">
          CURRENT RELEASE
        </span>
      </div>
      <div class="p-6 bg-zinc-950 flex flex-col items-center justify-center border-b border-zinc-800">
        <a href={PRODUCT_LINKS.cad.body2} target="_blank" class="font-mono text-xs text-sky-300 bg-sky-950/60 border border-sky-800 px-4 py-2 rounded hover:bg-sky-500/20 transition-colors">
          Open Enclosed Body 2.0 CAD in Onshape &rarr;
        </a>
      </div>
      <div class="p-4 text-xs text-zinc-300 leading-relaxed font-sans">
        Enclosed 3D shell protecting the dual microcontrollers, buck converters, and internal wire routing. Tested on a dedicated DTC testing stand with external 5.30V power.
      </div>
    </div>
  </section>
</MainLayout>