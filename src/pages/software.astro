---
import MainLayout from '../layouts/MainLayout.astro';
import TechBadge from '../components/TechBadge.astro';
import { PRODUCT_LINKS } from '../data/links';
---

<MainLayout title="Software & AI Brain">
  <section class="border-b border-zinc-800 pb-5 mb-6">
    <div class="font-mono text-xs text-sky-400 mb-1">// SOFTWARE_ARCHITECTURE</div>
    <h1 class="text-2xl sm:text-3xl font-bold text-zinc-100 mb-2">Software & AI Systems</h1>
    <p class="text-xs sm:text-sm text-zinc-400">
      How the AI understands commands, calculates leg geometry, and controls the motors.
    </p>
  </section>

  <!-- Web Controller Live Viewport Card -->
  <section class="border border-zinc-800 bg-zinc-900/60 rounded-xl overflow-hidden mb-6">
    <div class="bg-zinc-900 px-3.5 py-2 border-b border-zinc-800 font-mono text-xs text-zinc-300 flex items-center justify-between">
      <span>// OPERATOR_DASHBOARD</span>
      <a href={PRODUCT_LINKS.playgroundDemo} target="_blank" class="text-sky-400 hover:underline text-[10px]">
        Launch Live Dashboard &rarr;
      </a>
    </div>
    
    <div class="p-6 bg-zinc-950 border-b border-zinc-800 flex flex-col items-center justify-center gap-3">
      <span class="font-mono text-xs text-zinc-400">Interactive 3D WebGL Kinematic Twin</span>
      <a href={PRODUCT_LINKS.playgroundDemo} target="_blank" class="font-mono text-xs text-sky-300 bg-sky-950/60 border border-sky-800 px-4 py-2 rounded hover:bg-sky-500/20 transition-colors">
        ⚡ Open Live 3D Web Visualizer &rarr;
      </a>
    </div>
  </section>

  <!-- AI Voice Pipeline -->
  <section class="border border-zinc-800 bg-zinc-900/60 rounded-xl p-4 sm:p-5 mb-6">
    <div class="font-mono text-xs font-semibold text-zinc-400 mb-1">// 01_NATURAL_VOICE_AI</div>
    <h2 class="text-sm sm:text-base font-bold text-zinc-100 mb-2">How "Hey Spider" Works</h2>
    <p class="text-xs text-zinc-300 mb-3 leading-relaxed font-sans">
      The Raspberry Pi listens continuously for the wake word <strong>"Hey Spider"</strong>. When you speak a command (like <em>"Walk forward and look around"</em>), cloud AI turns your sentence into exact walking coordinates.
    </p>

    <div class="bg-zinc-950 p-3 rounded font-mono text-[11px] text-zinc-300 border border-zinc-800 overflow-x-auto">
      You Speak &rarr; Speech Recognition &rarr; Cloud AI (Llama 3.3) &rarr; JSON Action Packet &rarr; Robot Moves
    </div>
  </section>

  <!-- Dual Core Breakdown -->
  <section>
    <div class="font-mono text-xs font-semibold text-zinc-400 mb-2.5">// 02_DUAL_CORE_MOTOR_CONTROLLER</div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="border border-zinc-800 bg-zinc-900/40 rounded-xl p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono text-xs font-semibold text-zinc-200">Core 0: Communications</span>
          <TechBadge text="Wi-Fi" />
        </div>
        <p class="text-xs text-zinc-400 leading-relaxed font-sans">
          Dedicated entirely to Wi-Fi messages and telemetry. If a Wi-Fi packet lags, it will never interrupt the robot's physical step.
        </p>
      </div>

      <div class="border border-zinc-800 bg-zinc-900/40 rounded-xl p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono text-xs font-semibold text-zinc-200">Core 1: 100Hz Motion Loop</span>
          <TechBadge text="Motors" />
        </div>
        <p class="text-xs text-zinc-400 leading-relaxed font-sans">
          Dedicated 100% to calculating geometry and sending pulses to all 18 motor joints 100 times per second for smooth movement.
        </p>
      </div>
    </div>
  </section>
</MainLayout>