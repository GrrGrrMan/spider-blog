---
import MainLayout from '../layouts/MainLayout.astro';
import TechBadge from '../components/TechBadge.astro';
---

<MainLayout title="Software Architecture">
  <div class="mb-12">
    <h1 class="text-4xl font-bold text-white mb-4">Software Architecture</h1>
    <p class="text-slate-400 text-lg">A robust, non-blocking pipeline handling high-torque motors, live camera feeds, and LLM inference simultaneously.</p>
  </div>

  <div class="space-y-12">
    <!-- Web Interface Integration -->
    <section class="grid lg:grid-cols-2 gap-6">
      <div class="bg-slate-900/50 border border-white/10 p-6 md:p-8 rounded-2xl flex flex-col justify-center">
        <h2 class="text-2xl font-bold text-white mb-4">Web Dashboard Interface</h2>
        <p class="text-slate-300 mb-6 leading-relaxed text-sm">
          A custom dashboard running in the browser acts as the primary visual controller. When the robot powers on, it automatically sends its physical leg calibrations to the interface, allowing the 3D model to sync with the real robot.
        </p>
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-2">
            <span class="text-xs text-emerald-400 font-mono uppercase tracking-wider">Gait Control</span>
            <img src="/images/gait_controller_panel.png" alt="Gait Settings UI" class="rounded-lg border border-white/10 w-full" />
          </div>
          <div class="space-y-2">
            <span class="text-xs text-emerald-400 font-mono uppercase tracking-wider">Parameters</span>
            <img src="/images/ui_draggable_panel.png" alt="Draggable Settings UI" class="rounded-lg border border-white/10 w-full" />
          </div>
        </div>
      </div>
      
      <div class="bg-slate-900 border border-white/10 rounded-2xl overflow-hidden flex flex-col">
        <div class="p-4 border-b border-white/10 flex justify-between items-center bg-slate-950">
          <h3 class="font-bold text-white text-sm">Live 3D Telemetry Simulation</h3>
          <span class="w-3 h-3 bg-emerald-500 rounded-full animate-pulse"></span>
        </div>
        <div class="bg-black/50 flex-grow p-4 flex items-center justify-center">
          <img src="/images/hexapod_plot_sim_ui.png" alt="3D Plot Simulation" class="w-full max-h-[350px] object-contain rounded" />
        </div>
      </div>
    </section>

    <!-- AI Pipeline -->
    <section class="border border-white/10 rounded-2xl overflow-hidden bg-slate-900/50">
      <div class="p-6 border-b border-white/10 bg-slate-900">
        <h2 class="text-xl font-bold text-white flex items-center gap-3">
          <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          Multimodal AI Assistant
        </h2>
      </div>
      <div class="p-6">
        <p class="text-slate-300 mb-6 leading-relaxed">
          The robot listens 24/7 for the wake word <strong>'Hey Spider'</strong> using the browser's Web Speech API. Commands are processed via Groq Cloud (Llama 3.3 70B), converting natural language directly into kinematics parameters and motion presets.
        </p>
        <div class="bg-black/50 p-4 rounded-lg font-mono text-sm text-emerald-400 overflow-x-auto border border-white/5">
          User: "Walk forward slowly" -> Web Speech API -> Groq LLM -> JSON: { "gait": "tripod", "velocity": 0.5, "dir": "forward" } -> MQTT -> Robot
        </div>
      </div>
    </section>

    <!-- FreeRTOS Dual Core -->
    <section>
      <h2 class="text-2xl font-bold text-white mb-6">Firmware & Core Management</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-slate-900 border border-white/10 rounded-2xl p-6">
          <div class="flex justify-between items-center mb-4">
            <h3 class="font-bold text-white">Core 0: Network</h3>
            <TechBadge text="ESP32-S3" />
          </div>
          <ul class="space-y-3 text-sm text-slate-400 list-disc list-inside">
            <li>Maintains Wi-Fi connections.</li>
            <li>Handles MQTT publish/subscribe routes.</li>
            <li>Streams telemetry data to the Web UI at 10Hz.</li>
            <li>Processes Over-The-Air (OTA) firmware updates.</li>
          </ul>
        </div>
        
        <div class="bg-slate-900 border border-white/10 rounded-2xl p-6">
          <div class="flex justify-between items-center mb-4">
            <h3 class="font-bold text-white">Core 1: Kinematics</h3>
            <TechBadge text="FreeRTOS Task" />
          </div>
          <ul class="space-y-3 text-sm text-slate-400 list-disc list-inside">
            <li>Runs a precise 100Hz loop for walking gaits.</li>
            <li>Calculates Inverse Kinematics (IK).</li>
            <li>Communicates with dual PCA9685 I2C drivers.</li>
            <li>I2S audio stream handling without blocking math.</li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</MainLayout>