---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allLogs = await getCollection('logbook');
// Sort by our custom order number
const sortedLogs = allLogs.sort((a, b) => a.data.order - b.data.order);
---

<MainLayout title="Chronological Logbook">
  <div class="mb-12">
    <h1 class="text-4xl font-bold text-white mb-4">Building Logbook</h1>
    <p class="text-slate-400 text-lg">A timeline of the research, failures, and breakthroughs.</p>
  </div>

  <div class="relative border-l border-white/10 ml-3 md:ml-6 space-y-10 py-6">
    {sortedLogs.map((log) => (
      <div class="relative pl-8 md:pl-12">
        <!-- Timeline Dot -->
        <div class="absolute w-4 h-4 bg-emerald-500 rounded-full -left-[8.5px] top-1.5 shadow-[0_0_10px_rgba(52,211,153,0.5)]"></div>
        
        <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-4 mb-2">
          <span class="text-emerald-400 font-mono text-sm">{log.data.date}</span>
          <h3 class="text-xl font-bold text-white">{log.data.title}</h3>
        </div>
        <div class="prose prose-invert prose-slate prose-sm text-slate-300">
          <log.Content />
        </div>
      </div>
    ))}
  </div>
</MainLayout>