---
import MainLayout from '../../layouts/MainLayout.astro';
import { LOGBOOK_ENTRIES } from '../../data/logbookData';

const tagStyles = {
  research: "text-sky-400 bg-sky-950/60 border-sky-800",
  build: "text-zinc-300 bg-zinc-800/80 border-zinc-700",
  fail: "text-rose-400 bg-rose-950/60 border-rose-800",
  success: "text-emerald-400 bg-emerald-950/60 border-emerald-800",
  ai: "text-purple-400 bg-purple-950/60 border-purple-800",
};
---

<MainLayout title="Building Logbook">
  <section class="border-b border-zinc-800 pb-5 mb-6">
    <div class="font-mono text-xs text-sky-400 mb-1">// COMPLETE_BUILD_LOG</div>
    <h1 class="text-2xl sm:text-3xl font-bold text-zinc-100 mb-2">Chronological Building Logbook</h1>
    <p class="text-xs sm:text-sm text-zinc-400">
      Every research milestone, electrical failure, and breakthrough recorded during development.
    </p>
  </section>

  <!-- Timeline List -->
  <div class="relative border-l border-zinc-800 ml-2 sm:ml-4 space-y-6 py-2">
    {LOGBOOK_ENTRIES.map((entry) => (
      <div class="relative pl-6 sm:pl-8">
        <!-- Dot Node -->
        <div class="absolute w-2.5 h-2.5 bg-sky-400 rounded-full -left-[5.5px] top-1.5 ring-4 ring-zinc-950"></div>
        
        <div class="border border-zinc-800/80 bg-zinc-900/60 rounded-xl p-3.5 sm:p-4">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs text-sky-400 font-semibold">{entry.date}</span>
              <span class={`font-mono text-[10px] px-2 py-0.5 rounded border ${tagStyles[entry.tagType]}`}>
                {entry.tag}
              </span>
            </div>
          </div>
          
          <h3 class="text-sm sm:text-base font-bold text-zinc-100 mb-1.5">{entry.title}</h3>
          <p class="text-xs text-zinc-400 leading-relaxed font-sans">{entry.desc}</p>
        </div>
      </div>
    ))}
  </div>
</MainLayout>