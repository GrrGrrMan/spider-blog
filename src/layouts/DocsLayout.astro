---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Pagination from '../components/Pagination.astro';
import MobileSubNav from '../components/MobileSubNav.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  slug: string;
  rawFileId?: string;
  section: string;
  headings: Heading[];
}

const { title, description, slug, rawFileId, section, headings } = Astro.props;
const sourceFile = rawFileId || slug;
---

<BaseLayout title={title} description={description}>
  <MobileSubNav slot="sub-nav" headings={headings} section={section} />

  <div class="max-w-7xl w-full mx-auto px-3.5 sm:px-6 flex-grow flex">
    <!-- Left Navigation Sidebar -->
    <Sidebar currentSlug={slug} />

    <!-- Main Content Area -->
    <main id="main-content" class="flex-1 min-w-0 py-6 sm:py-8 px-0 sm:px-6 lg:px-8 max-w-4xl">
      <article aria-labelledby="page-title">
        <!-- Document Header Stack -->
        <header class="border-b border-zinc-800/80 pb-4 mb-6">
          <nav class="flex items-center gap-1.5 font-mono text-[11px] text-zinc-500 mb-3 overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
            <a href="/docs/mission-and-intentions" class="hover:text-zinc-300 transition-colors">Docs</a>
            <span class="text-zinc-600">/</span>
            <span class="text-sky-400 uppercase">{section}</span>
            <span class="text-zinc-600">/</span>
            <span class="text-zinc-300 truncate">{title}</span>
          </nav>
          <h1 id="page-title" class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-100">{title}</h1>
          {description && <p class="text-xs sm:text-sm text-zinc-400 mt-1.5 font-sans leading-relaxed">{description}</p>}
        </header>

        <!-- Markdown Body -->
        <div class="prose prose-invert prose-zinc max-w-none prose-headings:font-mono prose-headings:text-zinc-100 prose-a:text-sky-400 prose-code:font-mono prose-code:text-sky-300 prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-800">
          <slot />
        </div>

        <!-- Footer Actions & Metadata -->
        <footer class="mt-12 pt-6 border-t border-zinc-800/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs font-mono">
          <a
            href={`https://github.com/GrrGrrMan/spider-blog/edit/main/src/content/docs/${sourceFile}.md`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-zinc-400 hover:text-sky-400 transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>Edit this section on GitHub</span>
          </a>

          <!-- Feedback Region -->
          <div id="feedback-container" class="flex items-center bg-zinc-900/80 border border-zinc-800 px-3 py-1.5 rounded-lg min-h-[36px]" role="region" aria-label="Documentation feedback">
            <div id="feedback-prompt" class="flex items-center gap-2">
              <span class="text-zinc-400 text-[11px]">Was this section helpful?</span>
              <button
                id="feedback-yes"
                type="button"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-zinc-800 hover:bg-emerald-950/60 hover:text-emerald-300 hover:border-emerald-700 border border-zinc-700 rounded transition-colors text-[11px] text-zinc-300 cursor-pointer"
                aria-label="Yes, this section was helpful"
              >
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
                </svg>
                <span>Yes</span>
              </button>
              <button
                id="feedback-no"
                type="button"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-zinc-800 hover:bg-rose-950/60 hover:text-rose-300 hover:border-rose-700 border border-zinc-700 rounded transition-colors text-[11px] text-zinc-300 cursor-pointer"
                aria-label="No, this section was not helpful"
              >
                <svg class="w-3.5 h-3.5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76 1.04m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.904 0-.715.211-1.413.608-2.008L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5" />
                </svg>
                <span>No</span>
              </button>
            </div>
            <div id="feedback-ack" class="hidden items-center gap-1.5 text-emerald-400 text-[11px] font-semibold">
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Thank you for your feedback!</span>
            </div>
          </div>
        </footer>
        </article>

        <Pagination currentSlug={slug} />
      </main>

      <!-- Desktop Right Table of Contents -->
      <TableOfContents headings={headings} />
    </div>
</BaseLayout>