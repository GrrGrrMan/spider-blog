---
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Pagination from '../components/Pagination.astro';
import DiagramModal from '../components/diagram/DiagramModal.astro';
import { DOCS_NAVIGATION } from '../data/docsNav';
import { ViewTransitions } from 'astro:transitions';
import '../styles/docs.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  slug: string;
  section: string;
  headings: Heading[];
}

const { title, description, slug, section, headings } = Astro.props;
const totalDocsCount = DOCS_NAVIGATION.flatMap((s) => s.items).length;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth bg-zinc-950 text-zinc-300">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />
    <title>{title} | AI Spider V2 Docs</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ViewTransitions />
  </head>
  <body class="bg-zinc-950 text-zinc-300 font-['Plus_Jakarta_Sans',sans-serif] antialiased min-h-screen flex flex-col">
    <NavBar />

    <div class="max-w-7xl w-full mx-auto px-3.5 sm:px-6 flex-grow flex">
      <Sidebar currentSlug={slug} />

      <main class="flex-1 min-w-0 py-6 sm:py-8 px-0 sm:px-6 lg:px-8 max-w-4xl">
        <!-- Mobile Docs Navigation Selector (Hidden on Desktop) -->
        <div class="lg:hidden mb-4">
          <details class="group bg-zinc-900/80 border border-zinc-800 rounded-xl overflow-hidden font-mono text-xs">
            <summary class="flex items-center justify-between p-3.5 cursor-pointer select-none text-sky-400 font-semibold list-none">
              <span class="flex items-center gap-2">
                <span>DOCS EXPLORER ({totalDocsCount} SECTIONS)</span>
              </span>
              <span class="text-zinc-500 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <div class="p-3.5 border-t border-zinc-800 bg-zinc-950/80 space-y-4 max-h-80 overflow-y-auto">
              {DOCS_NAVIGATION.map((sec) => (
                <div>
                  <div class="text-[10px] text-zinc-500 uppercase tracking-wider font-bold mb-1.5 px-1">
                    {sec.sectionTitle}
                  </div>
                  <ul class="space-y-1">
                    {sec.items.map((item) => (
                      <li>
                        <a
                          href={`/docs/${item.slug}`}
                          class={`flex items-center justify-between px-2.5 py-2 rounded-lg text-xs transition-colors ${
                            slug === item.slug
                              ? 'bg-sky-950/80 border border-sky-800 text-sky-300 font-bold'
                              : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900'
                          }`}
                        >
                          <span class="truncate">{item.title}</span>
                          {item.badge && (
                            <span class="text-[9px] px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-sky-400 ml-1">
                              {item.badge}
                            </span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </div>

        <!-- Breadcrumbs -->
        <div class="flex items-center gap-1.5 font-mono text-[11px] text-zinc-500 mb-2 overflow-x-auto whitespace-nowrap">
          <span>DOCS</span>
          <span>/</span>
          <span class="text-sky-400 uppercase">{section}</span>
          <span>/</span>
          <span class="text-zinc-400 truncate">{title}</span>
        </div>

        <header class="border-b border-zinc-800/80 pb-4 mb-6">
          <h1 class="text-xl sm:text-3xl font-bold tracking-tight text-zinc-100">{title}</h1>
          {description && <p class="text-xs sm:text-sm text-zinc-400 mt-1 font-sans leading-relaxed">{description}</p>}
        </header>

        <article class="prose prose-invert prose-zinc max-w-none prose-headings:font-mono prose-headings:text-zinc-100 prose-a:text-sky-400 prose-code:font-mono prose-code:text-sky-300 prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-800">
          <slot />
        </article>

        <Pagination currentSlug={slug} />
      </main>

      <TableOfContents headings={headings} />
    </div>

    <DiagramModal />
    <Footer />

    <script src="../lib/diagram/index.ts"></script>
  </body>
</html>