---
import { PRODUCT_LINKS } from '../data/links';
---

<div class="border border-zinc-800 bg-zinc-900/80 rounded-xl p-4 sm:p-5 mb-6">
  <div class="flex items-center justify-between mb-3 border-b border-zinc-800 pb-2">
    <div class="font-mono text-xs font-semibold text-zinc-300 flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      // OPEN-SOURCE PRODUCT ASSETS
    </div>
    <span class="font-mono text-[10px] text-sky-400">SCIENCE FAIR 2026</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono">
    <!-- Live Demo App -->
    <a href={PRODUCT_LINKS.playgroundDemo} target="_blank" class="flex items-center justify-between p-2.5 rounded bg-zinc-950 border border-sky-500/30 text-sky-300 hover:bg-sky-500/10 transition-colors">
      <span>Live Interactive Web UI</span>
      <span class="text-zinc-500">&rarr;</span>
    </a>

    <!-- Firmware Repo -->
    <a href={PRODUCT_LINKS.repos.firmware} target="_blank" class="flex items-center justify-between p-2.5 rounded bg-zinc-950 border border-zinc-800 text-zinc-300 hover:border-zinc-700 transition-colors">
      <span>ESP32 Firmware Code</span>
      <span class="text-zinc-500">&rarr;</span>
    </a>

    <!-- Pi Hub Repo -->
    <a href={PRODUCT_LINKS.repos.piHub} target="_blank" class="flex items-center justify-between p-2.5 rounded bg-zinc-950 border border-zinc-800 text-zinc-300 hover:border-zinc-700 transition-colors">
      <span>Raspberry Pi 4 AI Hub</span>
      <span class="text-zinc-500">&rarr;</span>
    </a>

    <!-- Web UI Repo -->
    <a href={PRODUCT_LINKS.repos.webUi} target="_blank" class="flex items-center justify-between p-2.5 rounded bg-zinc-950 border border-zinc-800 text-zinc-300 hover:border-zinc-700 transition-colors">
      <span>Web Dashboard Source</span>
      <span class="text-zinc-500">&rarr;</span>
    </a>
  </div>
</div>