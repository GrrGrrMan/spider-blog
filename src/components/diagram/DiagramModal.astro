---
---
<dialog
  id="diagram-modal"
  class="backdrop:bg-zinc-950/60 backdrop:backdrop-blur-md bg-zinc-900/85 backdrop-blur-xl border border-zinc-800/90 text-zinc-100 p-0 rounded-2xl w-[96vw] h-[92dvh] max-w-7xl shadow-2xl overflow-hidden m-auto"
>
  <div class="flex-shrink-0 flex flex-wrap items-center justify-between gap-2 px-3 sm:px-5 py-2.5 border-b border-zinc-800/90 bg-zinc-950/80 backdrop-blur-md font-mono text-xs">
    <span class="text-sky-400 font-semibold flex items-center gap-2 text-[11px] sm:text-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span class="truncate">// FULLSCREEN_VIEWPORT</span>
    </span>
    <div class="flex flex-wrap items-center gap-1.5">
      <div id="modal-tour-nav-wrapper" class="flex items-center bg-zinc-900 border border-zinc-800 rounded px-1.5 py-1 gap-1">
        <span class="text-[10px] text-zinc-500 uppercase px-0.5">Tour:</span>
        <button id="modal-tour-prev" class="px-1.5 sm:px-2 py-1 hover:bg-zinc-800 rounded text-zinc-300 hover:text-sky-400 transition-colors text-[10px] sm:text-[11px]" title="Previous Block">‹ Prev</button>
        <span id="modal-step-indicator" class="text-[10px] text-sky-400 font-bold px-1 min-w-[28px] text-center">1/?</span>
        <button id="modal-tour-next" class="px-1.5 sm:px-2 py-1 hover:bg-zinc-800 rounded text-zinc-300 hover:text-sky-400 transition-colors text-[10px] sm:text-[11px]" title="Next Block">Next ›</button>
      </div>
      <div class="flex items-center gap-1 sm:gap-1.5">
        <button id="modal-zoom-out" class="min-w-[36px] min-h-[36px] px-2.5 py-1.5 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded-lg transition-colors text-zinc-300 font-bold text-xs flex items-center justify-center cursor-pointer" title="Zoom Out">-</button>
        <span id="modal-zoom-text" class="text-[10px] sm:text-xs text-zinc-500 w-9 text-center font-mono select-none">100%</span>
        <button id="modal-zoom-in" class="min-w-[36px] min-h-[36px] px-2.5 py-1.5 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded-lg transition-colors text-zinc-300 font-bold text-xs flex items-center justify-center cursor-pointer" title="Zoom In">+</button>
        <button id="modal-zoom-reset" class="min-h-[36px] px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded-lg transition-colors text-xs text-zinc-300 flex items-center justify-center cursor-pointer" title="Fit to Screen">⟲ Fit</button>
        <span class="text-zinc-700 hidden sm:inline">|</span>
        <button id="close-modal-btn" class="min-h-[36px] px-3.5 py-1.5 bg-zinc-800/90 hover:bg-zinc-700 text-zinc-200 rounded-lg border border-zinc-700 transition-colors text-xs font-semibold cursor-pointer flex items-center justify-center">
          ✕ Close
        </button>
      </div>
    </div>
  </div>
  <div id="modal-diagram-viewport" class="flex-1 w-full min-h-0 relative overflow-hidden bg-zinc-950/20 cursor-grab select-none flex items-center justify-center"></div>
</dialog>