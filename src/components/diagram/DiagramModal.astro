---
---
<dialog
  id="diagram-modal"
  class="backdrop:bg-zinc-950/90 backdrop:backdrop-blur-md bg-zinc-900 border border-zinc-800 text-zinc-100 p-0 rounded-2xl w-[96vw] h-[92dvh] max-w-7xl shadow-2xl overflow-hidden"
>
  <div class="flex flex-wrap items-center justify-between gap-2 px-3 sm:px-5 py-2.5 border-b border-zinc-800 bg-zinc-950 font-mono text-xs">
    <span class="text-sky-400 font-semibold flex items-center gap-2 text-[11px] sm:text-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span class="truncate">// FULLSCREEN_VIEWPORT</span>
    </span>
    <div class="flex items-center gap-1.5">
      <button id="modal-zoom-out" class="px-2.5 py-1 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded transition-colors text-zinc-300 font-bold" title="Zoom Out">-</button>
      <span id="modal-zoom-text" class="text-[10px] text-zinc-500 w-10 text-center">100%</span>
      <button id="modal-zoom-in" class="px-2.5 py-1 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded transition-colors text-zinc-300 font-bold" title="Zoom In">+</button>
      <button id="modal-zoom-reset" class="px-2.5 py-1 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 rounded transition-colors text-[11px] text-zinc-300" title="Fit to Screen">⟲ Fit</button>
      <span class="text-zinc-700">|</span>
      <button id="close-modal-btn" class="px-3 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded border border-zinc-700 transition-colors text-[11px] font-semibold">
        ✕ Close
      </button>
    </div>
  </div>
  <div id="modal-diagram-viewport" class="w-full h-[calc(100%-48px)] relative overflow-hidden bg-zinc-950/50 cursor-grab select-none p-3 sm:p-4 flex items-center justify-center"></div>
</dialog>