---
import { PRODUCT_LINKS } from '../data/links';
import { DOCS_NAVIGATION } from '../data/docsNav';
import SearchModal from './SearchModal.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const pathname = new URL(Astro.request.url).pathname;
const cleanPath = pathname.replace(/\/$/, "");
const isDocsPage = cleanPath.includes("/docs");

const navLinks = [
  { href: `${base}`, label: "Overview", active: cleanPath === "" || cleanPath === base.replace(/\/$/, "") },
  { href: `${base}docs/mission-and-intentions`, label: "Documentation", active: isDocsPage },
  { href: `${base}hardware`, label: "CAD & Parts", active: cleanPath.includes("hardware") },
  { href: `${base}logbook`, label: "Logbook", active: cleanPath.includes("logbook") },
];
---

<header class="sticky top-0 z-40 w-full bg-zinc-950 sm:bg-zinc-950/95 sm:backdrop-blur border-b border-zinc-800/80 transform-gpu">
  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 py-2 sm:py-2.5">
    <div class="flex items-center justify-between">
      <!-- Brand -->
      <a href={base} class="flex items-center gap-2 font-mono text-xs sm:text-sm font-bold tracking-wider text-zinc-100 uppercase focus-visible:ring-2 focus-visible:ring-sky-400 rounded flex-shrink-0">
        <span class="w-2 h-2 rounded-full bg-sky-400 flex-shrink-0"></span>
        AI_SPIDER <span class="text-zinc-600">//</span> <span class="text-sky-400">DOCS</span>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-1 font-mono text-xs">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-lg transition-colors ${
              link.active ? 'bg-zinc-800 text-sky-400 font-semibold' : 'text-zinc-400 hover:text-zinc-100 hover:bg-zinc-900/60'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right Header Actions -->
      <div class="flex items-center gap-2">
        <!-- ⌘K Search Trigger Button -->
        <button
          id="search-dialog-trigger"
          type="button"
          class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-zinc-200 hover:border-zinc-700 font-mono text-xs cursor-pointer transition-colors focus-visible:ring-2 focus-visible:ring-sky-400 min-h-[38px]"
          aria-label="Search documentation"
        >
          <svg class="w-3.5 h-3.5 text-zinc-400 flex-shrink-0" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline text-zinc-400">Search docs...</span>
          <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] bg-zinc-950 border border-zinc-800 rounded text-zinc-500 font-mono">⌘K</kbd>
        </button>

        <!-- Desktop External Links -->
        <a
          href={PRODUCT_LINKS.playgroundDemo}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 font-mono text-[11px] text-sky-300 bg-sky-950/60 border border-sky-800 px-2.5 py-1.5 rounded-lg hover:bg-sky-500/20 transition-colors focus-visible:ring-2 focus-visible:ring-sky-400 min-h-[38px] cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-sky-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
          <span>Live 3D Sim</span>
        </a>

        <a
          href={PRODUCT_LINKS.repos.blog}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 font-mono text-[11px] text-zinc-300 bg-zinc-900 border border-zinc-800 px-2.5 py-1.5 rounded-lg hover:border-zinc-700 transition-colors focus-visible:ring-2 focus-visible:ring-sky-400 min-h-[38px] group cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-zinc-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub</span>
          <svg class="w-3.5 h-3.5 text-zinc-600 group-hover:text-zinc-300 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <!-- Single Unified Mobile Drawer Toggle (44px WCAG Target) -->
        <button
          id="mobile-drawer-open"
          type="button"
          class="md:hidden flex items-center justify-center w-11 h-11 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-sky-400 hover:border-zinc-700 transition-colors focus-visible:ring-2 focus-visible:ring-sky-400 cursor-pointer"
          aria-label="Open Navigation Menu"
          aria-haspopup="dialog"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Off-Canvas Navigation Drawer (Slide-Over Sheet) -->
<dialog
  id="mobile-nav-drawer"
  class="backdrop:bg-zinc-950/80 backdrop:backdrop-blur-sm fixed inset-0 w-full h-[100dvh] max-w-sm ml-auto bg-zinc-950 border-l border-zinc-800 text-zinc-100 p-0 shadow-2xl overflow-hidden focus:outline-none transition-transform duration-300"
>
  <div class="h-full flex flex-col justify-between">
    <!-- Drawer Top Header -->
    <div class="p-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-950">
      <a href={base} class="flex items-center gap-2 font-mono text-xs font-bold tracking-wider text-zinc-100 uppercase">
        <span class="w-2 h-2 rounded-full bg-sky-400"></span>
        AI_SPIDER <span class="text-sky-400">// MENU</span>
      </a>
      <button
        id="mobile-drawer-close"
        type="button"
        class="w-9 h-9 flex items-center justify-center rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 text-sm font-mono cursor-pointer transition-colors"
        aria-label="Close navigation menu"
      >
        ✕
      </button>
    </div>

    <!-- Drawer Scrollable Body -->
    <div class="flex-1 overflow-y-auto p-4 space-y-6">
      <!-- Section 1: Main Segmented Navigation Pills -->
      <div>
        <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider font-bold mb-2">
          // SITE SECTIONS
        </div>
        <div class="grid grid-cols-2 gap-1.5 font-mono text-xs">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={`px-3 py-2.5 rounded-lg border text-center transition-colors ${
                link.active
                  ? 'bg-sky-950/70 border-sky-600/70 text-sky-300 font-bold'
                  : 'bg-zinc-900/80 border-zinc-800 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800'
              }`}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Section 2: Context-Aware Navigation -->
      {isDocsPage ? (
        <div>
          <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider font-bold mb-2.5">
            // DOCUMENTATION CHAPTERS
          </div>
          <div class="space-y-4 font-mono text-xs">
            {DOCS_NAVIGATION.map((sec) => (
              <div class="space-y-1">
                <div class="text-[11px] text-sky-400/90 font-semibold px-1">
                  {sec.sectionTitle}
                </div>
                <div class="space-y-0.5">
                  {sec.items.map((item) => {
                    const isActive = cleanPath.endsWith(`/docs/${item.slug}`);
                    return (
                      <a
                        href={`${base}docs/${item.slug}`}
                        class={`flex items-center justify-between px-2.5 py-2 rounded-lg transition-colors ${
                          isActive
                            ? 'bg-sky-950/80 border border-sky-600/70 text-sky-300 font-semibold'
                            : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900/80'
                        }`}
                      >
                        <span class="truncate">{item.title}</span>
                        {item.badge && (
                          <span class="text-[9px] px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-sky-400 ml-1">
                            {item.badge}
                          </span>
                        )}
                      </a>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div class="space-y-3 font-mono text-xs">
          <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider font-bold">
            // DOCUMENTATION HUB
          </div>
          <a
            href={`${base}docs/mission-and-intentions`}
            class="flex items-center justify-between p-3 rounded-xl bg-zinc-900/80 border border-zinc-800 hover:border-sky-500/50 hover:bg-sky-950/30 transition-all text-zinc-300 group"
          >
            <div>
              <div class="text-xs font-semibold text-zinc-200 group-hover:text-sky-300">Technical Manual</div>
              <div class="text-[11px] text-zinc-500 mt-0.5">Explore all 8 documentation chapters</div>
            </div>
            <svg class="w-4 h-4 text-zinc-500 group-hover:text-sky-400 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      )}
    </div>

    <!-- Drawer Footer Quick Links -->
    <div class="p-4 border-t border-zinc-800/80 bg-zinc-950 grid grid-cols-2 gap-2 text-center text-xs font-mono">
      <a
        href={PRODUCT_LINKS.playgroundDemo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-1.5 p-2.5 rounded-lg bg-sky-950/60 border border-sky-800 text-sky-300 font-semibold hover:bg-sky-900/50 transition-colors"
      >
        <svg class="w-3.5 h-3.5 text-sky-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        <span>Live 3D Sim</span>
      </a>
      <a
        href={PRODUCT_LINKS.repos.blog}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-1.5 p-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300 hover:bg-zinc-800 transition-colors group"
      >
        <svg class="w-3.5 h-3.5 text-zinc-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
        <svg class="w-3.5 h-3.5 text-zinc-600 group-hover:text-zinc-300 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</dialog>

<!-- Modularized Search Palette Component -->
<SearchModal />

<script>
  function setupMobileDrawer() {
    const openBtn = document.getElementById('mobile-drawer-open');
    const closeBtn = document.getElementById('mobile-drawer-close');
    const drawer = document.getElementById('mobile-nav-drawer') as HTMLDialogElement | null;

    if (!openBtn || !drawer) return;

    let isHistoryBound = false;

    const onPopState = () => {
      if (drawer.open) {
        closeDrawer(false);
      }
    };

    const openDrawer = () => {
      drawer.showModal();
      document.body.style.overflow = 'hidden';
      openBtn.setAttribute('aria-expanded', 'true');

      const astroState = window.history.state || {};
      window.history.pushState({ ...astroState, modalOpen: 'mobile-nav' }, '');
      if (!isHistoryBound) {
        window.addEventListener('popstate', onPopState);
        isHistoryBound = true;
      }
    };

    const closeDrawer = (revertHistory = true) => {
      if (!drawer.open) return;
      drawer.close();
      document.body.style.overflow = '';
      openBtn.setAttribute('aria-expanded', 'false');

      if (revertHistory && window.history.state?.modalOpen === 'mobile-nav') {
        window.history.back();
      }
    };

    openBtn.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) closeDrawer();
    });
  }

  setupMobileDrawer();
  document.addEventListener('astro:page-load', setupMobileDrawer);
</script>