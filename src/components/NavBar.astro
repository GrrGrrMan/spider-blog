---
import { PRODUCT_LINKS } from '../data/links';

const pathname = new URL(Astro.request.url).pathname;
const cleanPath = pathname.replace(/\/$/, "");

const navLinks = [
  { href: "/", label: "Overview", active: cleanPath === "" },
  { href: "/docs/01-system-overview", label: "Documentation", active: cleanPath.startsWith("/docs") },
  { href: "/methodology", label: "Methodology", active: cleanPath.includes("methodology") },
  { href: "/hardware", label: "CAD & Parts", active: cleanPath.includes("hardware") },
  { href: "/logbook", label: "Logbook", active: cleanPath.includes("logbook") },
];
---

<header class="sticky top-0 z-50 w-full bg-zinc-950/95 backdrop-blur border-b border-zinc-800/80">
  <div class="max-w-7xl mx-auto px-4 py-2.5">
    <div class="flex items-center justify-between">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-2 font-mono text-xs sm:text-sm font-bold tracking-wider text-zinc-100 uppercase">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></span>
        AI_SPIDER <span class="text-zinc-600">//</span> <span class="text-sky-400">DOCS_INDEX</span>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-1 font-mono text-xs">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-md transition-colors ${
              link.active ? 'bg-zinc-800 text-sky-400 font-semibold' : 'text-zinc-400 hover:text-zinc-100'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right Header Actions -->
      <div class="flex items-center gap-2">
        <!-- Enterprise Command+K Search Trigger -->
        <button
          id="search-dialog-trigger"
          class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg bg-zinc-900/90 border border-zinc-800 text-zinc-400 hover:text-zinc-200 hover:border-zinc-700 font-mono text-xs transition-colors focus-visible:ring-2 focus-visible:ring-sky-400"
          aria-label="Search documentation"
        >
          <svg class="w-3.5 h-3.5 text-zinc-400 flex-shrink-0" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline text-zinc-400">Search docs...</span>
          <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] bg-zinc-950 border border-zinc-800 rounded text-zinc-500">⌘K</kbd>
        </button>

        <a
          href={PRODUCT_LINKS.playgroundDemo}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 font-mono text-[11px] text-sky-300 bg-sky-950/60 border border-sky-800 px-2.5 py-1.5 rounded hover:bg-sky-500/20 transition-colors focus-visible:ring-2 focus-visible:ring-sky-400"
        >
          <span>Live 3D Sim</span>
        </a>

        <a
          href={PRODUCT_LINKS.repos.firmware}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex font-mono text-[11px] text-zinc-300 bg-zinc-900 border border-zinc-800 px-2.5 py-1.5 rounded hover:border-zinc-700 transition-colors focus-visible:ring-2 focus-visible:ring-sky-400"
        >
          GitHub &rarr;
        </a>

        <!-- Mobile Hamburger Toggle Button -->
        <button
          id="mobile-nav-toggle"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-sky-400 hover:border-zinc-700 transition-colors focus-visible:ring-2 focus-visible:ring-sky-400"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-nav-menu"
    class="hidden md:hidden border-t border-zinc-800/80 bg-zinc-950 px-4 py-3 space-y-1.5 font-mono text-xs shadow-2xl"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`block px-3 py-2.5 rounded-lg transition-colors ${
          link.active
            ? 'bg-sky-950/60 border border-sky-800 text-sky-300 font-bold'
            : 'text-zinc-400 hover:bg-zinc-900 hover:text-zinc-100'
        }`}
      >
        {link.label}
      </a>
    ))}

    <div class="pt-2.5 mt-2 border-t border-zinc-800/80 grid grid-cols-2 gap-2 text-center text-[11px]">
      <a
        href={PRODUCT_LINKS.playgroundDemo}
        target="_blank"
        class="p-2.5 rounded bg-sky-950/60 border border-sky-800 text-sky-300 font-semibold"
      >
        ⚡ Live 3D Sim
      </a>
      <a
        href={PRODUCT_LINKS.repos.firmware}
        target="_blank"
        class="p-2.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-300"
      >
        GitHub Repo &rarr;
      </a>
    </div>
  </div>
</header>

<!-- Command+K Search Modal Dialog -->
<dialog
  id="search-palette-modal"
  class="backdrop:bg-zinc-950/80 backdrop:backdrop-blur-sm bg-zinc-900 border border-zinc-800 text-zinc-100 p-0 rounded-2xl w-[94vw] max-w-xl shadow-2xl overflow-hidden"
>
  <div class="p-3 border-b border-zinc-800 flex items-center gap-2.5 bg-zinc-950">
    <svg class="w-4 h-4 text-sky-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      id="search-palette-input"
      type="text"
      placeholder="Search documentation, topics, pins, math..."
      class="w-full bg-transparent border-none text-zinc-100 placeholder-zinc-500 font-mono text-xs focus:outline-none"
    />
    <button id="close-search-btn" class="text-zinc-500 hover:text-zinc-300 text-xs font-mono px-1.5 py-0.5 rounded border border-zinc-800">
      ESC
    </button>
  </div>

  <div id="search-results-box" class="p-2 max-h-72 overflow-y-auto space-y-1 font-mono text-xs">
    <!-- Dynamic Results -->
  </div>
</dialog>

<script>
  import { DOCS_NAVIGATION } from '../data/docsNav';

  function setupMobileNav() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const menu = document.getElementById('mobile-nav-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!toggleBtn || !menu) return;

    toggleBtn.onclick = () => {
      const isHidden = menu.classList.contains('hidden');
      menu.classList.toggle('hidden', !isHidden);
      hamburgerIcon?.classList.toggle('hidden', isHidden);
      closeIcon?.classList.toggle('hidden', !isHidden);
      toggleBtn.setAttribute('aria-expanded', String(isHidden));
    };
  }

  function setupSearchPalette() {
    const searchBtn = document.getElementById('search-dialog-trigger');
    const modal = document.getElementById('search-palette-modal') as HTMLDialogElement | null;
    const input = document.getElementById('search-palette-input') as HTMLInputElement | null;
    const resultsBox = document.getElementById('search-results-box');
    const closeBtn = document.getElementById('close-search-btn');

    if (!modal || !input || !resultsBox) return;

    const allDocs = DOCS_NAVIGATION.flatMap((sec) =>
      sec.items.map((item) => ({ ...item, section: sec.sectionTitle }))
    );

    function renderResults(query: string) {
      if (!resultsBox) return;
      const q = query.toLowerCase().trim();
      const filtered = q === '' 
        ? allDocs 
        : allDocs.filter((d) => d.title.toLowerCase().includes(q) || d.section.toLowerCase().includes(q) || d.slug.toLowerCase().includes(q));

      if (filtered.length === 0) {
        resultsBox.innerHTML = `<div class="p-4 text-center text-zinc-500">No documentation entries match "${query}"</div>`;
        return;
      }

      resultsBox.innerHTML = filtered
        .map(
          (doc) => `
          <a
            href="/docs/${doc.slug}"
            class="flex items-center justify-between p-2.5 rounded-lg hover:bg-zinc-800/80 transition-colors text-zinc-300 hover:text-sky-300"
          >
            <div>
              <div class="text-[10px] text-zinc-500 uppercase tracking-wider">${doc.section}</div>
              <div class="font-semibold text-zinc-200 mt-0.5">${doc.title}</div>
            </div>
            <span class="text-[11px] text-zinc-500 font-mono">/docs/${doc.slug} &rarr;</span>
          </a>
        `
        )
        .join('');
    }

    const openSearch = () => {
      modal.showModal();
      input.value = '';
      renderResults('');
      input.focus();
    };

    const closeSearch = () => modal.close();

    searchBtn?.addEventListener('click', openSearch);
    closeBtn?.addEventListener('click', closeSearch);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeSearch();
    });

    input.addEventListener('input', (e) => {
      renderResults((e.target as HTMLInputElement).value);
    });

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        modal.open ? closeSearch() : openSearch();
      }
    });
  }

  setupMobileNav();
  setupSearchPalette();
  document.addEventListener('astro:page-load', () => {
    setupMobileNav();
    setupSearchPalette();
  });
</script>