---
const pathname = new URL(Astro.request.url).pathname;
const cleanPath = pathname.replace(/\/$/, "");
---

<header class="sticky top-0 z-50 w-full bg-zinc-950/95 backdrop-blur border-b border-zinc-800/80">
  <div class="max-w-7xl mx-auto px-4 py-2.5">
    <div class="flex items-center justify-between">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-2.5 font-mono text-xs sm:text-sm font-bold tracking-wider text-zinc-100 uppercase">
        <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></span>
        AI_SPIDER <span class="text-zinc-600">//</span> <span class="text-sky-400">DOCS_INDEX</span>
      </a>

      <!-- Central Nav Links -->
      <nav class="hidden md:flex items-center gap-1 font-mono text-xs">
        <a
          href="/"
          class={`px-3 py-1.5 rounded-md transition-colors ${cleanPath === '' ? 'bg-zinc-800 text-sky-400 font-semibold' : 'text-zinc-400 hover:text-zinc-100'}`}
        >
          Overview
        </a>
        <a
          href="/docs/01-system-overview"
          class={`px-3 py-1.5 rounded-md transition-colors ${cleanPath.startsWith('/docs') ? 'bg-zinc-800 text-sky-400 font-semibold' : 'text-zinc-400 hover:text-zinc-100'}`}
        >
          Documentation
        </a>
        <a
          href="/methodology"
          class={`px-3 py-1.5 rounded-md transition-colors ${cleanPath.includes('methodology') ? 'bg-zinc-800 text-sky-400 font-semibold' : 'text-zinc-400 hover:text-zinc-100'}`}
        >
          Methodology
        </a>
        <a
          href="/hardware"
          class={`px-3 py-1.5 rounded-md transition-colors ${cleanPath.includes('hardware') ? 'bg-zinc-800 text-sky-400 font-semibold' : 'text-zinc-400 hover:text-zinc-100'}`}
        >
          CAD & Parts
        </a>
        <a
          href="/logbook"
          class={`px-3 py-1.5 rounded-md transition-colors ${cleanPath.includes('logbook') ? 'bg-zinc-800 text-sky-400 font-semibold' : 'text-zinc-400 hover:text-zinc-100'}`}
        >
          Logbook
        </a>
      </nav>

      <!-- Right Header Actions -->
      <div class="flex items-center gap-2">
        <a
          href="https://spiderbot-playground.netlify.app/"
          target="_blank"
          class="hidden sm:inline-flex items-center gap-1.5 font-mono text-[11px] text-sky-300 bg-sky-950/60 border border-sky-800 px-2.5 py-1 rounded hover:bg-sky-500/20 transition-colors"
        >
          <span>⚡ Live 3D Sim</span>
        </a>
        <a
          href="https://github.com/GrrGrrMan/spiderbot-firmware"
          target="_blank"
          class="font-mono text-[11px] text-zinc-300 bg-zinc-900 border border-zinc-800 px-2.5 py-1 rounded hover:border-zinc-700 transition-colors"
        >
          GitHub &rarr;
        </a>
      </div>
    </div>
  </div>
</header>