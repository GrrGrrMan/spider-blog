---
import { PRODUCT_LINKS } from '../data/links';
---

<footer class="border-t border-zinc-800/80 bg-zinc-950 py-8 mt-16 text-xs font-mono text-zinc-400">
  <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="space-y-1 text-center sm:text-left">
      <p class="text-zinc-300 font-semibold">AI Spider 18-DOF Hexapod V2 &bull; 2026 project</p>
      <p class="text-zinc-500 text-[11px]">Software under MIT &bull; Hardware under CERN-OHL-P v2</p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-3 text-[11px]">
      <a href={PRODUCT_LINKS.repos.firmware} target="_blank" class="hover:text-sky-400 transition-colors">Firmware</a>
      <span class="text-zinc-700">&bull;</span>
      <a href={PRODUCT_LINKS.repos.piHub} target="_blank" class="hover:text-sky-400 transition-colors">Pi AI Hub</a>
      <span class="text-zinc-700">&bull;</span>
      <a href={PRODUCT_LINKS.repos.webUi} target="_blank" class="hover:text-sky-400 transition-colors">Web UI</a>
      <span class="text-zinc-700">&bull;</span>
      <a href={PRODUCT_LINKS.cad.body2} target="_blank" class="hover:text-sky-400 transition-colors">Onshape CAD</a>
    </div>
  </div>
</footer>