---
import { PRODUCT_LINKS } from '../data/links';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="w-64 flex-shrink-0 hidden xl:block sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto pl-5 py-6 border-l border-zinc-800/80">
  <div class="space-y-6">
    <div>
      <div class="flex items-center justify-between mb-3">
        <span class="font-mono text-[10px] uppercase tracking-widest text-sky-400 font-bold">
          // ON THIS PAGE
        </span>
        <span class="text-[10px] font-mono text-zinc-600">SCROLLSPY</span>
      </div>
      
      {filteredHeadings.length === 0 ? (
        <p class="text-xs font-mono text-zinc-500">No subheadings</p>
      ) : (
        <nav id="toc-nav" class="relative space-y-1 text-xs font-mono border-l border-zinc-800/80 pl-2" aria-label="Table of contents">
          {filteredHeadings.map((h) => (
            <a
              href={`#${h.slug}`}
              data-heading-slug={h.slug}
              class={`toc-link flex items-center justify-between py-1 transition-colors duration-150 rounded px-2 group ${
                h.depth === 3 
                  ? 'pl-4 text-[11px] text-zinc-400 hover:text-zinc-200' 
                  : 'text-zinc-300 hover:text-sky-300 font-medium'
              }`}
            >
              <span class="truncate">{h.text}</span>
              <span class="text-zinc-600 group-hover:text-sky-400 opacity-0 group-hover:opacity-100 transition-opacity text-[10px]">#</span>
            </a>
          ))}
        </nav>
      )}
    </div>

    <!-- Quick External Assets -->
    <div class="border-t border-zinc-800/80 pt-4 space-y-2 font-mono text-xs">
      <span class="text-[10px] text-zinc-500 uppercase tracking-wider block">// ARTIFACTS & CAD</span>
      <a
        href={PRODUCT_LINKS.cad.body2}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-2 rounded-lg bg-zinc-900/60 border border-zinc-800 text-sky-300 hover:bg-sky-950/40 text-[11px] transition-colors focus-visible:ring-1 focus-visible:ring-sky-400 group"
      >
        <span>Onshape 3D CAD</span>
        <svg class="w-3.5 h-3.5 text-zinc-500 group-hover:text-sky-400 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href={PRODUCT_LINKS.playgroundDemo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-2 rounded-lg bg-zinc-900/60 border border-sky-500/30 text-sky-300 hover:bg-sky-950/40 text-[11px] transition-colors focus-visible:ring-1 focus-visible:ring-sky-400 group"
      >
        <span>Live 3D Web Sim</span>
        <svg class="w-3.5 h-3.5 text-sky-400 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      <a
        href={PRODUCT_LINKS.repos.firmware}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-2 rounded-lg bg-zinc-900/60 border border-zinc-800 text-zinc-400 hover:text-zinc-200 text-[11px] transition-colors focus-visible:ring-1 focus-visible:ring-sky-400 group"
      >
        <span>GitHub Repository</span>
        <svg class="w-3.5 h-3.5 text-zinc-500 group-hover:text-zinc-300 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</aside>

<!-- TOC Scrollspy is cleanly driven by src/lib/client/scrollspy.ts via BaseLayout lifecycle -->