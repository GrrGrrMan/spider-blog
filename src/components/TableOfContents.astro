---
import { PRODUCT_LINKS } from '../data/links';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="w-64 flex-shrink-0 hidden xl:block sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto pl-5 py-6 border-l border-zinc-800/80">
  <div class="space-y-6">
    <div>
      <div class="flex items-center justify-between mb-3">
        <span class="font-mono text-[10px] uppercase tracking-widest text-sky-400 font-bold">
          // ON THIS PAGE
        </span>
        <span class="text-[10px] font-mono text-zinc-600">SCROLLSPY</span>
      </div>
      
      {filteredHeadings.length === 0 ? (
        <p class="text-xs font-mono text-zinc-500">No subheadings</p>
      ) : (
        <nav id="toc-nav" class="relative space-y-1 text-xs font-mono border-l border-zinc-800/80 pl-2">
          {filteredHeadings.map((h) => (
            <a
              href={`#${h.slug}`}
              data-heading-slug={h.slug}
              class={`toc-link block py-1 transition-all duration-150 rounded px-2 ${
                h.depth === 3 
                  ? 'pl-4 text-[11px] text-zinc-400 hover:text-zinc-200' 
                  : 'text-zinc-300 hover:text-sky-300 font-medium'
              }`}
            >
              {h.text}
            </a>
          ))}
        </nav>
      )}
    </div>

    <!-- Quick External Assets -->
    <div class="border-t border-zinc-800/80 pt-4 space-y-2 font-mono text-xs">
      <span class="text-[10px] text-zinc-500 uppercase tracking-wider block">// ARTIFACTS & CAD</span>
      <a
        href={PRODUCT_LINKS.cad.body2}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-2 rounded-lg bg-zinc-900/60 border border-zinc-800 text-sky-300 hover:bg-sky-950/40 text-[11px] transition-colors focus-visible:ring-1 focus-visible:ring-sky-400"
      >
        <span>Onshape 3D CAD</span>
        <span>&rarr;</span>
      </a>
      <a
        href={PRODUCT_LINKS.playgroundDemo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-2 rounded-lg bg-zinc-900/60 border border-sky-500/30 text-sky-300 hover:bg-sky-950/40 text-[11px] transition-colors focus-visible:ring-1 focus-visible:ring-sky-400"
      >
        <span>Live 3D Web Sim</span>
        <span>&rarr;</span>
      </a>
      <a
        href={PRODUCT_LINKS.repos.firmware}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-2 rounded-lg bg-zinc-900/60 border border-zinc-800 text-zinc-400 hover:text-zinc-200 text-[11px] transition-colors focus-visible:ring-1 focus-visible:ring-sky-400"
      >
        <span>GitHub Repository</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</aside>

<script>
  function setupTocScrollSpy() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (tocLinks.length === 0) return;

    const headingElements: HTMLElement[] = [];
    tocLinks.forEach((link) => {
      const slug = link.getAttribute('data-heading-slug');
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      }
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            tocLinks.forEach((link) => {
              const matches = link.getAttribute('data-heading-slug') === id;
              if (matches) {
                link.classList.add('text-sky-400', 'bg-sky-950/50', 'font-semibold', 'translate-x-1');
                link.classList.remove('text-zinc-400', 'text-zinc-300');
                link.setAttribute('aria-current', 'location');
              } else {
                link.classList.remove('text-sky-400', 'bg-sky-950/50', 'font-semibold', 'translate-x-1');
                link.classList.add('text-zinc-400');
                link.removeAttribute('aria-current');
              }
            });
          }
        });
      },
      { rootMargin: '-80px 0% -60% 0%', threshold: 0.1 }
    );

    headingElements.forEach((h) => observer.observe(h));
  }

  setupTocScrollSpy();
  document.addEventListener('astro:page-load', setupTocScrollSpy);
</script>