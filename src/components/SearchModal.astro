---
---

<!-- Accessible W3C WAI-ARIA 1.2 Command+K Search Modal -->
<dialog
  id="search-palette-modal"
  class="backdrop:bg-zinc-950/80 backdrop:backdrop-blur-sm bg-zinc-900 border border-zinc-800 text-zinc-100 p-0 rounded-2xl w-[94vw] max-w-2xl shadow-2xl overflow-hidden m-auto"
  aria-label="Search documentation"
>
  <!-- Search Input Header -->
  <div class="p-3.5 border-b border-zinc-800 flex items-center gap-3 bg-zinc-950">
    <svg class="w-4 h-4 text-sky-400 flex-shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      id="search-palette-input"
      type="search"
      role="combobox"
      aria-expanded="false"
      aria-haspopup="listbox"
      aria-autocomplete="list"
      aria-controls="search-results-box"
      placeholder="Search documentation, pins, math, parts..."
      class="w-full bg-transparent border-none text-zinc-100 placeholder-zinc-500 font-sans text-sm focus:outline-none"
    />
    <button
      id="close-search-btn"
      type="button"
      class="text-zinc-500 hover:text-zinc-300 text-[11px] font-mono px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 cursor-pointer transition-colors"
      aria-label="Close search palette"
    >
      ESC
    </button>
  </div>

  <!-- Accessible Grouped Results Listbox -->
  <div
    id="search-results-box"
    role="listbox"
    aria-label="Search suggestions"
    class="p-3 max-h-[65vh] overflow-y-auto space-y-4 font-sans text-sm"
  >
    <!-- Dynamic Grouped Results -->
  </div>
  
  <!-- Footer Command Helpers -->
  <div class="px-4 py-2.5 border-t border-zinc-800/80 bg-zinc-950 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-zinc-500">
    <div class="flex items-center gap-3">
      <span class="flex items-center gap-1">
        <kbd class="px-1.5 py-0.5 bg-zinc-900 border border-zinc-800 rounded text-zinc-400 font-mono text-[10px]">↵</kbd>
        <span>to select</span>
      </span>
      <span class="flex items-center gap-1">
        <kbd class="px-1.5 py-0.5 bg-zinc-900 border border-zinc-800 rounded text-zinc-400 font-mono text-[10px]">↓</kbd>
        <kbd class="px-1.5 py-0.5 bg-zinc-900 border border-zinc-800 rounded text-zinc-400 font-mono text-[10px]">↑</kbd>
        <span>to navigate</span>
      </span>
      <span class="flex items-center gap-1">
        <kbd class="px-1.5 py-0.5 bg-zinc-900 border border-zinc-800 rounded text-zinc-400 font-mono text-[10px]">esc</kbd>
        <span>to close</span>
      </span>
    </div>
    <span class="text-zinc-600 font-mono text-[10px]">AI SPIDER DOCSEARCH</span>
  </div>
</dialog>

<script>
  import { initSearchPalette } from '../lib/client/searchPalette';
  import { lifecycle } from '../lib/client/lifecycle';

  lifecycle.init(() => {
    initSearchPalette();
  });
</script>